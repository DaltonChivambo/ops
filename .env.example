# MozaOps — environment variables
# Copie para `.env` e ajuste. O `.env` NÃO vai para o controlo de versões.

# ─── De onde vêm as imagens e os pacotes ────────────────────────────────────
# Com Internet, deixar comentado: tudo vem do Docker Hub e do PyPI.
# Na rede do banco, onde só o Harbor e o Nexus são alcançáveis, descomentar e
# preencher. Vale para o `make up`, o `docker compose` e os scripts de `ci/`.
#
# Harbor: as imagens ficam <registo>/<projecto>/<imagem>:<tag>.
# IMAGE_REGISTRY=<host do Harbor>
# IMAGE_NAMESPACE=<projecto do Harbor>
#
# Nexus: o URL do índice `simple` do repositório pypi. O TRUSTED_HOST só é
# preciso quando o Nexus serve em HTTP, e leva só o host.
# PYPI_INDEX_URL=<URL do Nexus, terminado em /simple/>
# PYPI_TRUSTED_HOST=<host do Nexus>
#
# Só para publicar (ci/service.sh push, ci/package.sh publish):
# DOCKER_REGISTRY=<host do Harbor>
# PYPI_PUBLISH_URL=<URL do repositório pypi hosted do Nexus>
# UV_IMAGE=<host do Harbor>/<projecto>/uv:0.12.1-python3.14-trixie-slim

# ─── Domains ────────────────────────────────────────────────────────────────
# Em desenvolvimento, *.localhost resolve para 127.0.0.1 sem tocar no /etc/hosts.
DOMAIN=mozaops.localhost

# ─── PostgreSQL ─────────────────────────────────────────────────────────────
# O superutilizador só é usado pelo initdb; os serviços entram com o seu role.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=mude-me-em-producao
POSTGRES_DB=postgres

# Um role por serviço, sem permissão de ligação às bases dos outros.
#
# O `cases` NÃO é sobra de um serviço por construir: é a contraparte que
# torna o isolamento demonstrável. O `scripts/verify-m0.sh` usa-o para provar
# que o REVOKE CONNECT funciona — «o role cases NÃO se liga à base da
# reconciliação» — que é a garantia do ARCHITECTURE.md §5. Apagá-lo deixava
# a regra de isolamento sem prova nenhuma.
DB_RECONCILIATION_USER=pos_closing_credit_validation
DB_RECONCILIATION_PASSWORD=mude-me-em-producao
DB_CASES_USER=cases
DB_CASES_PASSWORD=mude-me-em-producao

# ─── Identidade: o GEEA ─────────────────────────────────────────────────────
# Quem autentica é o GEEA, o sistema de identidade do banco. Em desenvolvimento
# quem faz o papel dele é o mock em `external-services/geea-keycloak/`, que
# assina como o real (RS256) e publica as chaves no mesmo caminho — por isso a
# passagem ao ambiente real é trocar estes endereços, e não mudar código.
AUTH_ISSUER=http://geea-keycloak:8000/auth/realms/QAS
AUTH_JWKS_URL=http://geea-keycloak:8000/auth/realms/QAS/protocol/openid-connect/certs
GEEA_SSOLOGIN_URL=http://geea-keycloak:8000/geea/idmUtils/SSOLogin
GEEA_TOKEN_URL=http://geea-keycloak:8000/auth/realms/QAS/protocol/openid-connect/token
GEEA_REALM=QAS

# Para o GEEA real do QAS, trocar as quatro linhas de cima por estas, com o
# host dele — o `AUTH_ISSUER` tem de as acompanhar, porque
# é o `iss` que vem dentro do token e é contra ele que o verificador compara.
# AUTH_ISSUER=http://<host do GEEA do QAS>/auth/realms/QAS
# AUTH_JWKS_URL=http://<host do GEEA do QAS>/auth/realms/QAS/protocol/openid-connect/certs
# GEEA_SSOLOGIN_URL=http://<host do GEEA do QAS>/geea/idmUtils/SSOLogin
# GEEA_TOKEN_URL=http://<host do GEEA do QAS>/auth/realms/QAS/protocol/openid-connect/token

# As credenciais de serviço do MozaOps no GEEA. Em produção vêm do cofre.
# `qa-mozaops` é o cliente com que o MozaOps está registado no QAS: é esse o
# `azp` que os tokens trazem.
GEEA_CLIENT_ID=qa-mozaops
GEEA_CLIENT_SECRET=mude-me-em-producao

# Clientes cujos tokens aceitamos — o `azp` do token. Um token legítimo do GEEA
# emitido para outra aplicação do banco não serve para entrar aqui. Acompanha o
# `GEEA_CLIENT_ID` acima: é esse o cliente com que pedimos os tokens.
AUTH_ALLOWED_AZP=qa-mozaops

# O cliente cujos papéis concedem acesso ao MozaOps. Lê-se daqui, e não do `azp`
# do token: admitir mais um cliente na lista acima passa a ser admitir um
# cliente, e não delegar-lhe a atribuição dos nossos acessos.
AUTH_CLIENT_ID=qa-mozaops

# ─── Áreas do MozaOps ───────────────────────────────────────────────────────
# Quem decide o que cada pessoa abre é, primeiro, o realm QAS: os papéis do
# cliente `qa-mozaops` no token (`channels`, `payment-methods`,
# `fraud-monitoring`) têm o nome da área que abrem, e o backend vai lê-los a
# `resource_access`. Isso não se configura aqui — configura-se no GEEA. O
# `all-areas` é o papel que abre tudo, para quem tem de ver o sistema inteiro.
#
# O que fica aqui é a rede por baixo, para as unidades e as pessoas que o realm
# ainda não provisionou. As duas variáveis são lidas pelos DOIS serviços, do
# mesmo sítio — dois serviços a mapear áreas de maneira diferente seria uma
# porta aberta no que ficasse para trás. As regras estão em
# `mozaops_libs/auth/areas.py`.
#
# Formato: `area:unidade,unidade;area:unidade`. A área é a do catálogo do
# MozaOps (a mesma que a barra lateral do SPA mostra); as unidades são os
# códigos que o GEEA manda na claim `departmentCode` — nem todos são
# departamentos, há áreas, serviços e gabinetes.
#
# `channels` (código GEEA 3230, «Canais e Serviços de Integração») é a unidade
# de quem trata do POS/ATM/Quiosques — NÃO é o departamento inteiro (`2350`,
# «Departamento de Apoio Operacional»), que também tem «Meios de Pagamento»
# (2442) como unidade própria e distinta. A barra lateral agrupa as duas sob o
# mesmo rótulo visual; o acesso é à unidade, não ao rótulo.
#
# Não há área por omissão de propósito: uma de recurso daria a plataforma a
# qualquer pessoa do banco que consiga autenticar-se.
AUTH_AREAS=channels:3230
# Acréscimo por pessoa, para quem está registado noutra unidade mas trabalha
# nesta. Mesmo formato, com `username` em vez de código.
#
# Vazio é o normal: o papel no realm chega. Para quem o IAM ainda não
# provisionou — um token sem papel nenhum do `qa-mozaops` — uma entrada como
# `channels:m001926` põe a pessoa a trabalhar entretanto.
AUTH_AREA_USERS=
# Acesso a uma automação só, sem dar a área inteira: os papéis
# `service:<id>:read` e `service:<id>:write` do realm, onde `<id>` é o
# `AUTH_SERVICE_ID` do serviço. Serve para programas que integram connosco e
# para quem consulta sem mexer. Não se configura aqui — configura-se no GEEA.
#
# A área a que a automação de fechos pertence — a mesma do `service.yaml` — e o
# id dela. São as únicas variáveis de autenticação que diferem entre serviços.
AUTH_SERVICE_AREA=channels
AUTH_SERVICE_ID=pos-closing-credit-validation

# ─── Sessão ─────────────────────────────────────────────────────────────────
# Só viaja em HTTPS. `*.localhost` conta como origem segura, e em
# desenvolvimento o browser aceita-o na mesma.
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_PATH=/api/auth-service
LOGIN_ATTEMPTS_PER_MINUTE=10

# ─── Application ────────────────────────────────────────────────────────────
# Estas são as que os serviços lêem, e são só estas: a lista vive em
# `app/settings.py`, e uma variável que não esteja declarada lá é ignorada
# em silêncio — foi o que aconteceu ao LOG_LEVEL até agora.
LOG_LEVEL=INFO
# Tamanho máximo de cada ficheiro carregado. Acima disto o pedido é recusado
# com 413, antes de o Excel chegar a ser aberto.
MAX_UPLOAD_MB=64
