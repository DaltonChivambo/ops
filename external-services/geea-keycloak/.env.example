# Credenciais aceites pelo /geea/idmUtils/SSOLogin
#
# Os utilizadores são dois e estão em `app/main.py`, na tabela `USERS`: é lá
# que se muda quem existe, em que unidade está e que áreas abre. A password
# abaixo é a de ambos — é um mock, uma por pessoa só dava mais que decorar.
GEEA_KEYCLOAK_REALM=QAS
GEEA_KEYCLOAK_PASSWORD=mude-me-em-producao
GEEA_KEYCLOAK_CLIENT_ID=qa-mozaops
GEEA_KEYCLOAK_CLIENT_SECRET=mude-me-em-producao

# Os JWT são assinados com RS256, com um par RSA gerado ao arranque — não há
# segredo de assinatura para configurar. Quem valida vai buscar a chave ao
# JWKS em /auth/realms/{realm}/protocol/openid-connect/certs
GEEA_KEYCLOAK_TOKEN_TTL=18000
# Emissor dos tokens. Por omissão o próprio mock, alcançável de dentro da rede
# `mozaops`; no GEEA real é svdcpapq70:10080
GEEA_KEYCLOAK_ISS_HOST=geea-keycloak:8000
GEEA_KEYCLOAK_ALLOWED_ORIGIN=http://svdcpapq51:8085

# O `scope` das claims, igual para todos os utilizadores
GEEA_MOCK_SCOPE=AD email profile
