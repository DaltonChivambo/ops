{
  "rabbit_version": "3.13.0",
  "users": [
    { "name": "ops", "password": "ops_dev_pw", "tags": ["administrator"] }
  ],
  "vhosts": [{ "name": "/" }],
  "permissions": [
    { "user": "ops", "vhost": "/", "configure": ".*", "write": ".*", "read": ".*" }
  ],
  "exchanges": [
    { "name": "ops.events", "vhost": "/", "type": "topic", "durable": true, "auto_delete": false, "arguments": {} },
    { "name": "ops.dlx",    "vhost": "/", "type": "topic", "durable": true, "auto_delete": false, "arguments": {} }
  ],
  "queues": [
    {
      "name": "notification.events", "vhost": "/", "durable": true, "auto_delete": false,
      "arguments": { "x-dead-letter-exchange": "ops.dlx", "x-dead-letter-routing-key": "notification.dead" }
    },
    {
      "name": "reporting.events", "vhost": "/", "durable": true, "auto_delete": false,
      "arguments": { "x-dead-letter-exchange": "ops.dlx", "x-dead-letter-routing-key": "reporting.dead" }
    },
    {
      "name": "ticketing.events", "vhost": "/", "durable": true, "auto_delete": false,
      "arguments": { "x-dead-letter-exchange": "ops.dlx", "x-dead-letter-routing-key": "ticketing.dead" }
    },
    {
      "name": "approval.events", "vhost": "/", "durable": true, "auto_delete": false,
      "arguments": { "x-dead-letter-exchange": "ops.dlx", "x-dead-letter-routing-key": "approval.dead" }
    },
    { "name": "ops.dead", "vhost": "/", "durable": true, "auto_delete": false, "arguments": {} }
  ],
  "bindings": [
    { "source": "ops.events", "vhost": "/", "destination": "notification.events", "destination_type": "queue", "routing_key": "#", "arguments": {} },
    { "source": "ops.events", "vhost": "/", "destination": "reporting.events",    "destination_type": "queue", "routing_key": "#", "arguments": {} },
    { "source": "ops.events", "vhost": "/", "destination": "ticketing.events",    "destination_type": "queue", "routing_key": "ativo.*", "arguments": {} },
    { "source": "ops.events", "vhost": "/", "destination": "ticketing.events",    "destination_type": "queue", "routing_key": "pedido.decidido", "arguments": {} },
    { "source": "ops.events", "vhost": "/", "destination": "approval.events",     "destination_type": "queue", "routing_key": "pedido.*", "arguments": {} },
    { "source": "ops.dlx",    "vhost": "/", "destination": "ops.dead",            "destination_type": "queue", "routing_key": "#", "arguments": {} }
  ],
  "policies": [],
  "parameters": []
}
