# reporting — copiar para .env em desenvolvimento local.
SERVICE_NAME=reporting
ENVIRONMENT=development
PORT=8006
LOG_LEVEL=INFO

# Um role por serviço: só tem GRANT no schema reporting.
DATABASE_URL=postgresql+psycopg://reporting_svc:reporting_dev_pw@localhost:5432/ops
DB_SCHEMA=reporting

# Keycloak externo (corporativo)
KEYCLOAK_URL=https://keycloak.exemplo.local
KEYCLOAK_REALM=ops
KEYCLOAK_CLIENT_ID=ops-backend

GRAYLOG_HOST=localhost
GRAYLOG_PORT=12201

RABBITMQ_URL=amqp://ops:ops_dev_pw@localhost:5672/
RABBITMQ_EXCHANGE=ops.events

